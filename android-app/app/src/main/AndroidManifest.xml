<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      守护服务使用 specialUse 而不是 dataSync：
      · Android 15 起 dataSync 前台服务有 24 小时共 6 小时配额，撑不住常驻通知；
      · Android 15 起 BOOT_COMPLETED 禁止启动 dataSync 类型前台服务（specialUse 不受限）。
      保留 FOREGROUND_SERVICE_DATA_SYNC 仅因 androidx.work 合并清单时可能声明它。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      省电豁免：直接弹「忽略电池优化」授权框。自动签到要在后台准时执行，
      未豁免时会被 App Standby 分桶限制闹钟频次（Rare 桶每窗口仅 1 次）。
      本应用走 GitHub 侧载分发，不涉及 Google Play 对该权限的政策限制。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 精确闹钟：让随机签到时刻不被 Doze 推迟；被撤销时自动降级为非精确闹钟。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".QingxinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_legacy"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher_legacy"
        android:supportsRtl="true"
        android:theme="@style/Theme.QingxinSignIn"
        android:usesCleartextTraffic="false">

        <!-- 小米可选增强：曝光刷新 / 版本号；无此 meta 时仍为标准 Android AppWidget -->
        <meta-data
            android:name="miuiWidgetVersion"
            android:value="4" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 4×2 主卡 -->
        <receiver
            android:name=".widget.TodayCourseWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_SIGN_NOW" />
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_course_widget_info" />
            <!-- 小米 Widget 标识：负一屏/桌面拖拽与曝光刷新能力；其他 ROM 会忽略 -->
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="10000" />
        </receiver>

        <!-- 2×2：独立 label，避免 ColorOS Shelf 把三种规格合并/隐藏 -->
        <receiver
            android:name=".widget.TodayCourseCompactWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_label_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_SIGN_NOW" />
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_course_widget_compact_info" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="10000" />
        </receiver>

        <!-- 4×4 -->
        <receiver
            android:name=".widget.TodayCourseTallWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_label_tall">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_SIGN_NOW" />
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_course_widget_tall_info" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="10000" />
        </receiver>

        <receiver
            android:name=".attendance.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          宿主环境变化 → 重绘小部件 + 重排边界闹钟。
          这些广播都在 Android 隐式广播豁免名单中，可安全静态注册；
          androidx.work 的 RescheduleReceiver 同样以 exported=false 接收
          BOOT_COMPLETED，因此这里也用 false 更安全。
        -->
        <receiver
            android:name=".widget.WidgetHostEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          边界闹钟：在每节课的「开课前 25 分钟 / 上课 / 下课」以及跨天时刻更新，
          使内容在语义变化的那一刻刷新，而不是等下一个 15 分钟周期。
          使用显式 PendingIntent，无需 intent-filter。
        -->
        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- requestPinAppWidget 成功回调；ColorOS 部分版本不弹确认框就直接添加 -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ucas.qingxin.signin.action.WIDGET_PINNED" />
            </intent-filter>
        </receiver>

        <!-- 自动签到：每节课 1 个精确闹钟（显式 PendingIntent，无需 intent-filter） -->
        <receiver
            android:name=".attendance.AutoSignAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".attendance.AttendanceDaemonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="scheduled_auto_checkin_daemon" />
        </service>
    </application>
</manifest>
