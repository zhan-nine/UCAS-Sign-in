<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      跨安卓桌面网格兼容：
      - AOSP 经验公式：minSize ≈ 70×n − 30
        2×2→110×110 | 4×2→250×110 | 4×4→250×250
      - Android 12+ 另用 targetCellWidth/Height 锁定格数
      - 小米 HyperOS 建议表为 110/300/250；用 targetCell 锁格后，
        以 AOSP 250 宽更不易在原生启动器占成 5 列
    -->
    <dimen name="widget_2x2_min_width">110dp</dimen>
    <dimen name="widget_2x2_min_height">110dp</dimen>
    <dimen name="widget_4x2_min_width">250dp</dimen>
    <dimen name="widget_4x2_min_height">110dp</dimen>
    <dimen name="widget_4x4_min_width">250dp</dimen>
    <dimen name="widget_4x4_min_height">250dp</dimen>
    <!-- 圆角：兼顾系统裁切；2K 见 values-sw411dp -->
    <dimen name="widget_corner">16dp</dimen>
    <dimen name="widget_pad">14dp</dimen>
</resources>
