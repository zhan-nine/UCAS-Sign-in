<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      跨安卓桌面网格兼容：
      - AOSP 官方换算：格数 n ↔ minSize ≈ 70×n − 30
        2×2→110×110 | 4×2→250×110 | 4×4→250×250
      - 小米 HyperOS 建议表为 110/300/250；用 targetCell（API 31+）锁格后，
        以 AOSP 的 250dp 宽在所有启动器上都能稳定落成 4 列，不会占成 5 列
      - maxResize* 仅 API 31+ 生效，给用户放大空间，避免被判定为「不可缩放」
    -->
    <dimen name="widget_2x2_min_width">110dp</dimen>
    <dimen name="widget_2x2_min_height">110dp</dimen>
    <dimen name="widget_4x2_min_width">250dp</dimen>
    <dimen name="widget_4x2_min_height">110dp</dimen>
    <dimen name="widget_4x4_min_width">250dp</dimen>
    <dimen name="widget_4x4_min_height">250dp</dimen>

    <dimen name="widget_2x2_max_width">250dp</dimen>
    <dimen name="widget_2x2_max_height">250dp</dimen>
    <dimen name="widget_4x2_max_width">460dp</dimen>
    <dimen name="widget_4x2_max_height">460dp</dimen>
    <dimen name="widget_4x4_max_width">460dp</dimen>
    <dimen name="widget_4x4_max_height">460dp</dimen>

    <!-- 圆角：兼顾系统裁切；2K 见 values-sw411dp -->
    <dimen name="widget_corner">16dp</dimen>
    <dimen name="widget_pad">14dp</dimen>
</resources>
