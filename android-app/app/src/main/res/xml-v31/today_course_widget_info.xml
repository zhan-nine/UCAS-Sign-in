<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 · API 31+ 增强版
  - **故意不写 targetCell***：ColorOS / OxygenOS 16 会错误解释该字段并把小部件压扁
    （成熟项目 BeeCount #307 已验证；移除后改由 minWidth 换算格数）
  - 保留 maxResize* 与 previewLayout：原生 / Pixel / HyperOS 选择器体验更好
  - ColorOS 选择器若忽略 previewLayout，会回退到 previewImage
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_loading"
    android:maxResizeWidth="@dimen/widget_4x2_max_width"
    android:maxResizeHeight="@dimen/widget_4x2_max_height"
    android:minWidth="@dimen/widget_4x2_min_width"
    android:minHeight="@dimen/widget_4x2_min_height"
    android:minResizeWidth="@dimen/widget_4x2_min_resize_width"
    android:minResizeHeight="@dimen/widget_4x2_min_resize_height"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
