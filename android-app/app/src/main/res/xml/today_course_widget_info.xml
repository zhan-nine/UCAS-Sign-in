<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 主卡 · 全 API 通用声明（含 ColorOS / OxygenOS / HyperOS）

  成熟项目结论（BeeCount #307、Breezy Weather、Fossify）：
  - ColorOS 对 targetCellWidth/Height 处理有误 → **一律不写**
  - 只靠 minWidth/minHeight，让启动器按本机网格换算格数
  - previewImage 必须提供；previewLayout 在部分 ColorOS 选择器上会缓存异常，
    因此基础版只用 previewImage，v31 版才补 previewLayout 作为增强
  - minResize 放小，避免被判定为「不可用 / 不可缩放」
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="@dimen/widget_4x2_min_width"
    android:minHeight="@dimen/widget_4x2_min_height"
    android:minResizeWidth="@dimen/widget_4x2_min_resize_width"
    android:minResizeHeight="@dimen/widget_4x2_min_resize_height"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
