<?xml version="1.0" encoding="utf-8"?>
<!--
  跨安卓 4×2 主卡：
  min 250×110（AOSP 格数公式）+ targetCell 4×2（API 31+）
  updatePeriodMillis=30min：非小米系统的兜底刷新；小米另有曝光刷新
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="@dimen/widget_4x2_min_width"
    android:minHeight="@dimen/widget_4x2_min_height"
    android:minResizeWidth="@dimen/widget_4x2_min_width"
    android:minResizeHeight="@dimen/widget_4x2_min_height"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
